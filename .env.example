# Phase 0: local loopback only. Do not add real data or provider credentials yet.
PORT=3002
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:8080
# Supply a random 32+ character owner passphrase locally; no default.
POKI_BOOTSTRAP_PASSWORD=
# Existing absolute, owned, private (0700), non-symlink data directory, outside repo.
SAFE_DATA_DIR=
# AI is opt-in only; keep disabled until the Phase 0 review is accepted.
POKI_ENABLE_AI=false
GROQ_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=groq
